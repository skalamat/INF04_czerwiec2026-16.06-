<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Notatki_16_06.MainPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListView Grid.Row="0" x:Name="notatkiListView" ItemSelected="notatkiListView_ItemSelected">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextCell Text="{Binding tytul}" Detail="{Binding tresc}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <VerticalStackLayout Grid.Row="1">
            <Entry x:Name="tytulEntry" Placeholder="Podaj tytuł notatki" />
            <Entry x:Name="trescEntry" Placeholder="Podaj treść notatki" />
            <Button x:Name="DodajNotatkeButton" Clicked="DodajNotatkeButton_Clicked" Text="Dodaj notatkę" />
        </VerticalStackLayout>
    </Grid>

</ContentPage>